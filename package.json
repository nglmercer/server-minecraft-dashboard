{
  "name": "Minecraft-Dashboard",
  "version": "1.3.0",
  "description": "A simple dashboard to manage your Minecraft server",
  "type": "module",
  "main": "entry.js",
  "author": "melserpe",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "electron": "electron .",
    "build": "electron-builder --config electron-builder.yml",
    "build:windows": "electron-builder --win --config electron-builder.yml",
    "build:linux": "electron-builder --linux --config electron-builder.yml"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/middie": "^9.0.3",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.1",
    "@fastify/websocket": "^11.0.2",
    "archiver": "^7.0.1",
    "axios": "^1.4.0",
    "bonjour": "^3.5.0",
    "cheerio": "^1.1.0",
    "colors": "^1.4.0",
    "decompress": "^4.2.1",
    "fastify": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^2.1.35",
    "minecraft-server-properties": "^1.0.0",
    "node-cron": "^4.1.0",
    "strip-ansi": "^7.1.0",
    "systeminformation": "^5.27.3",
    "tar": "^7.4.3",
    "tree-kill": "^1.2.2",
    "uuid": "^11.0.5",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "nodemon": "^3.1.9"
  }
}
